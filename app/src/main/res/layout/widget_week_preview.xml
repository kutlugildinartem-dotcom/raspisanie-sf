<?xml version="1.0" encoding="utf-8"?>
<!-- Статичный пример карточки недели для галереи выбора виджета (API 31+). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card"
        android:backgroundTint="#FF1A1D21" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Эта неделя"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23 — 28 сентября"
            android:textSize="13sp"
            android:textColor="#FFAAAAAA" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Понедельник"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="09:00 Мат. анализ · 10:40 Программирование"
            android:textSize="12sp"
            android:textColor="#FFAAAAAA"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вторник"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="12:20 Физика · 14:00 Английский язык"
            android:textSize="12sp"
            android:textColor="#FFAAAAAA"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
</FrameLayout>
