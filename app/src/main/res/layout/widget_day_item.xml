<?xml version="1.0" encoding="utf-8"?>
<!--
  Карточка одного дня в списке виджета «День».

  Строка пары: слева время и тип занятия, по центру название (до двух строк),
  справа кабинет цветной плашкой. Пары делят высоту карточки поровну, размеры
  шрифта подбираются в коде под высоту строки.

  Только классы из разрешённого списка RemoteViews: Space, View и прочие
  валят инфлейт в процессе лаунчера, и виджет висит на «Загрузка…».
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
