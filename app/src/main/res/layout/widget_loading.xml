<?xml version="1.0" encoding="utf-8"?>
<!--
  Первый кадр виджета, пока система не запросила данные. Показывается
  доли секунды; цвет текста задан явно, иначе на тёмных обоях он
  чёрный по тёмному и виджет выглядит пустым.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="#FF7A7A82"
        android:text="RUUNIT" />
</FrameLayout>
