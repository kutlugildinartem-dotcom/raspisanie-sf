<?xml version="1.0" encoding="utf-8"?>
<!--
  Карточка одной недели внутри StackView. Шесть учебных дней, у каждого
  заголовок и до пяти пар. Строки статичны: элемент коллекции RemoteViews
  не может содержать вложенную коллекцию.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/week_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/week_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:maxLines="1" />

        <TextView
            android:id="@+id/week_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFAAAAAA"
            android:maxLines="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <TextView
            android:id="@+id/week_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="#FFAAAAAA"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/week_days"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/day_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/day_name_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/day_badge_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="@drawable/widget_chip"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FF000000"
                        android:maxLines="1"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/day_lessons_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFAAAAAA"
                    android:maxLines="4"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/day_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/day_name_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/day_badge_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="@drawable/widget_chip"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FF000000"
                        android:maxLines="1"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/day_lessons_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFAAAAAA"
                    android:maxLines="4"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/day_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/day_name_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/day_badge_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="@drawable/widget_chip"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FF000000"
                        android:maxLines="1"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/day_lessons_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFAAAAAA"
                    android:maxLines="4"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/day_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/day_name_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/day_badge_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="@drawable/widget_chip"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FF000000"
                        android:maxLines="1"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/day_lessons_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFAAAAAA"
                    android:maxLines="4"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/day_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/day_name_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/day_badge_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="@drawable/widget_chip"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FF000000"
                        android:maxLines="1"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/day_lessons_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFAAAAAA"
                    android:maxLines="4"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/day_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/day_name_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/day_badge_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="@drawable/widget_chip"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FF000000"
                        android:maxLines="1"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/day_lessons_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFAAAAAA"
                    android:maxLines="4"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
