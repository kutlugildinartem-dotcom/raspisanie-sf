<?xml version="1.0" encoding="utf-8"?>
<!--
  Запасной вид виджета, если render() упал с исключением. Только TextView
  внутри FrameLayout — оба точно входят в разрешённый RemoteViews список
  классов, так что этот вид сам никогда не должен упасть при инфлейте.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/widget_error_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF1A1D21"
        android:gravity="center"
        android:padding="16dp"
        android:textSize="13sp"
        android:textColor="#FFDDDDDD" />
</FrameLayout>
