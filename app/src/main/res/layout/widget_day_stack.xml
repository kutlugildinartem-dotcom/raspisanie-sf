<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «День»: плоский список карточек дней, каждая высотой во весь виджет,
  так что видно только текущий день. Следующие дни — свайпом вверх.
  Горизонтальный свайп виджету недоступен: его всегда забирает лаунчер.

  Только классы из разрешённого списка RemoteViews: Space, View и прочие
  валят инфлейт в процессе лаунчера, и виджет висит на «Загрузка…».
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ListView
        android:id="@+id/day_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/day_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="20dp"
        android:textSize="15sp"
        android:textColor="#FFDDDDDD"
        android:text="Откройте приложение и выберите группу"
        android:visibility="gone" />
</FrameLayout>
